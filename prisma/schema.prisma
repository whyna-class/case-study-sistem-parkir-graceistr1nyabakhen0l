generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

enum jenis_kendaraan{
  roda2
  roda4
}

model Parkir {
  id               Int       @id @default(autoincrement())
  plat_nomor       String
  jenis_kendaraan  jenis_kendaraan
  durasi           Int
  total            Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
